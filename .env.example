# Copy this file to .env for local development and fill in the real values.
# Vite exposes every VITE_* variable to browser code, so only put public
# frontend configuration here. Do not store private API keys, Cognito client
# secrets, AWS credentials, or signing secrets in VITE_* variables; keep those
# in a backend or your hosting provider's protected secret store.

VITE_APP_ORIGIN=http://localhost:5173
VITE_COGNITO_REGION=your-cognito-region
VITE_COGNITO_CLIENT_ID=your-public-cognito-app-client-id
VITE_COGNITO_AUTHORITY=https://cognito-idp.your-cognito-region.amazonaws.com/your-user-pool-id
VITE_COGNITO_REDIRECT_URI=http://localhost:5173/auth/callback
VITE_COGNITO_LOGOUT_URI=http://localhost:5173
